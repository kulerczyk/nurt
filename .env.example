# === Supabase — Project Settings → Database → Connection string ===
# Pooled connection (port 6543, pgbouncer) — używana przez aplikację w runtime
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — używana tylko przez Prisma do migracji
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# === Supabase — Project Settings → API ===
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"
# Klucz serwisowy — TYLKO po stronie serwera, nigdy w kodzie klienckim!
SUPABASE_SERVICE_ROLE_KEY="xxxxx"

# === Resend — powiadomienia e-mail z formularzy kontaktowych ===
# Klucz z resend.com/api-keys. Bez niego formularze działają (zapis do bazy
# + panel admina), tylko e-maile nie są wysyłane — patrz README.
RESEND_API_KEY="re_xxxxxxxxxxxx"
# Adres, na który mają przychodzić powiadomienia o nowych zapytaniach.
CONTACT_ADMIN_EMAIL="kontakt@twojadomena.pl"
# Adres/nazwa nadawcy widoczna w mailach — domyślnie testowy adres Resend,
# do produkcji wymaga zweryfikowanej domeny w Resend (Domains → Add Domain).
CONTACT_FROM_EMAIL="NURT <onboarding@resend.dev>"

# === Adres publiczny strony — wymagany przez Przelewy24 (urlReturn/urlStatus) ===
# Na Vercel można pominąć — użyty zostanie automatyczny VERCEL_URL. Do własnej
# domeny produkcyjnej ustaw pełny adres z https://.
NEXT_PUBLIC_SITE_URL="https://nurt.pl"

# === Przelewy24 — panel.przelewy24.pl (lub sandbox.przelewy24.pl) → Ustawienia sklepu ===
# Bez tych zmiennych Sklep działa (katalog, koszyk, zamówienia trafiają do panelu
# admina jako "oczekujące"), ale klienci nie mogą zapłacić online — patrz README.
P24_MERCHANT_ID="12345"
P24_POS_ID="12345"
P24_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
P24_CRC_KEY="xxxxxxxxxxxxxxxx"
# "true" = środowisko testowe (sandbox.przelewy24.pl), "false" = produkcja
P24_SANDBOX="true"
